# Where the Next.js route handler at /api/[...path] forwards to.
API_PROXY_TARGET=http://localhost:8000

# Same token the API enforces; the Next.js proxy injects it as Authorization.
# Never prefixed with NEXT_PUBLIC_ — must stay server-side so the client
# bundle doesn't carry the secret.
# API_AUTH_TOKEN=

# Legacy fallback if API_PROXY_TARGET is not set. Prefer API_PROXY_TARGET.
NEXT_PUBLIC_API_BASE=http://localhost:8000
