ANTHROPIC_API_KEY=sk-ant-...
RUN_DIR=./runs
LLM_DRY_RUN=true
LLM_TRACE=true
LLM_CLI_TIMEOUT_SECONDS=180

# LLM model routing — defaults match core/config.py.
ANTHROPIC_MODEL_OPUS=claude-opus-4-7
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
# Per-agent override: MODEL_<AGENT_NAME>=<model-id>. Wins over the role default.
# MODEL_PPG_MAPPING=claude-sonnet-4-6

# Where the GE drift suite looks for the baseline snapshot JSON.
BASELINE_DIR=core/data/baselines

# API server (FastAPI)
# Comma-separated origins allowed by CORS; falls back to localhost:3000 if unset.
ALLOWED_ORIGINS=http://localhost:3000
# If set, every API route (except /health) requires `Authorization: Bearer <token>`.
# Leave empty to disable auth (dev default).
API_AUTH_TOKEN=
# Hard cap on upload size in MiB (default 200).
MAX_UPLOAD_MB=200

# Next.js (web/)
# Where the Next.js route handler at /api/[...path] forwards to.
API_PROXY_TARGET=http://localhost:8000
# Same token the API enforces; the Next.js proxy injects it as Authorization.
# Never prefixed with NEXT_PUBLIC_ — must stay server-side so the client bundle
# doesn't carry the secret.
# API_AUTH_TOKEN=
NEXT_PUBLIC_API_BASE=http://localhost:8000
